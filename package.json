{
  "name": "the-new-frontier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "dev": "pnpm --filter @new-frontier/app dev",
    "build": "pnpm --filter @new-frontier/app build",
    "preview": "pnpm --filter @new-frontier/app preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "guard:legacy": "pnpm --filter @new-frontier/tools guard:legacy",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guard:legacy",
    "test:e2e": "pnpm build && playwright test",
    "sim": "pnpm --filter @new-frontier/tools sim",
    "sim:report": "pnpm --filter @new-frontier/tools sim:report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@new-frontier/core": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
